  "tiebreakers": {
    "note": "Applied before term scoring. These encode ops-head decisions about ownership, not text similarity.",
    "rules": [
      {
        "if_regulatory": "REG_E_EFT",
        "then_department": "CARDS_DISPUTES",
        "reason": "Reg E disputes are worked by Cards & Disputes regardless of channel"
      },
      {
        "if_regulatory": "RESPA_SERVICING",
        "then_department": "MORTGAGE_SERVICING",
        "reason": "RESPA notices of error must be worked by the servicer of record"
      },
      {
        "if_regulatory": "FDCPA_COLLECT",
        "then_department": "COLLECTIONS",
        "reason": "Collection conduct is owned by Collections leadership"
      },
      {
        "if_regulatory": "FCRA_FURNISH",
        "then_department": "DEPOSIT_OPS",
        "reason": "PLACEHOLDER \u2014 ops head has not told us who owns furnishing disputes. See docs/DECISIONS.md Q4."
      }
    ],
    "conflict_note": "When an ownership rule sends a case somewhere the complaint's own vocabulary does not point, the routing agent lowers its confidence and records `ownership_rule_conflict`. The rule still wins \u2014 ownership is management's call, not the system's \u2014 but the conflict is surfaced rather than hidden behind a 0.95. On our corpus this is what exposes the REG_E_EFT rule sending every identity-theft complaint to Cards & Disputes instead of Fraud & Security."
  }
}